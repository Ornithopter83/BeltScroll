[sub_resource type="Shader" id="Shader_title_shade"]
code = "shader_type canvas_item;\n\nuniform vec4 shade_color : source_color = vec4(0.015, 0.030, 0.028, 0.56);\nuniform float edge_strength = 0.36;\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat edge = smoothstep(0.22, 0.92, distance(uv, vec2(0.5, 0.48)));\n\tfloat alpha = clamp(shade_color.a + edge * edge_strength, 0.0, 0.88);\n\tCOLOR = vec4(shade_color.rgb, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_title_shade"]
shader = SubResource("Shader_title_shade")

